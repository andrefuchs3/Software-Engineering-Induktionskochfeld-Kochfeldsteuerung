@startuml
left to right direction

object HmiInput
object CooktopController
object SafetyManager
object MisuseDetector
object HmiOutput

' HmiInput -> CooktopController
HmiInput -> CooktopController : Bedienanforderung
note on link
1. increasePower(zone)
2. Weitergabe an CooktopController.increasePower(zone)
end note

' CooktopController -> SafetyManager
CooktopController -> SafetyManager : Sperrprüfung
note left of SafetyManager
3. isLocked()
4. Rückgabe: true (Kindersicherung aktiv)
end note

' CooktopController -> MisuseDetector
CooktopController -> MisuseDetector : Fehlbedienung
note bottom of MisuseDetector
7. registerInvalidOperation(reason, out)
end note

' CooktopController -> HmiOutput
CooktopController -> HmiOutput : Fehleranzeige
note right of HmiOutput
5. showError("Bedienung gesperrt")
6. showLock(true)
end note

' MisuseDetector -> HmiOutput
MisuseDetector -> HmiOutput : Warnung
note bottom of HmiOutput
8. showWarning("Fehlbedienung erkannt")
end note

@enduml
